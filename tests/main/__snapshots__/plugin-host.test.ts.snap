// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`parses captured LV2 discovery records and writes Carla patchbay XML 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE CARLA-PROJECT>
<CARLA-PROJECT VERSION="2.5">
 <Plugin><Info><Type>LV2</Type><Name>room</Name><URI>https://github.com/michaelwillis/dragonfly-reverb</URI></Info><Data><Active>Yes</Active><ControlChannel>1</ControlChannel></Data></Plugin>
 <Patchbay>
  <Connection><Source>room:Audio Output 1</Source><Target>Audio Output:Left</Target></Connection>
  <Connection><Source>room:Audio Output 2</Source><Target>Audio Output:Right</Target></Connection>
 </Patchbay>
</CARLA-PROJECT>
"
`;
