{
  "name": "xmxsplayer",
  "version": "0.1.0",
  "description": "A desktop workspace for transcription by ear and live MIDI performance.",
  "license": "MIT",
  "author": "Alexander Serdyukov",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win portable zip --x64",
    "postinstall": "node scripts/copy-worklets.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "immer": "^11.2.10",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
